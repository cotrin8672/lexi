{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lexi",
  "version": "0.1.0",
  "identifier": "io.github.cotrin8672.lexi",
  "mainBinaryName": "lexi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lexi",
        "width": 500,
        "height": 620,
        "minWidth": 360,
        "minHeight": 360,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
