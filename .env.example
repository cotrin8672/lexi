# Copy to .env and fill only the provider you use.
# .env is gitignored.

# Gemini accepts either name. GEMINI_API_KEY is preferred by Lexi.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI fallback provider.
OPENAI_API_KEY=

# Lexi Review mobile (Android). mise mobile-* tasks load these via dotenvx.
LEXI_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Web OAuth client id for native Google sign-in (not the Android client id).
LEXI_GOOGLE_WEB_CLIENT_ID=
